# Copy to .env (never commit .env) and edit.

# The server's LAN IP address, e.g. 192.168.1.10. Give it a DHCP reservation on your router.
HOST_IP=192.168.1.10

# Timezone name from the tz database (Bangladesh = Asia/Dhaka)
TZ=Asia/Dhaka

# Pi-hole admin password. Use a long unique one; do not reuse a password from elsewhere.
PIHOLE_PASSWORD=change-me-to-a-long-random-passphrase

# Public address clients use to reach WireGuard: your public IP or a dynamic DNS hostname.
WG_SERVERURL=vpn.example.com

# One WireGuard config is generated per name (comma separated, letters and digits only).
WG_PEERS=laptop,phone
