# Copy these into your shell (export ...) or a .env loader. Never commit real values.
# 1. Talk to @BotFather on Telegram, send /newbot, copy the token.
# 2. Send any message to your new bot, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id": ...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: where results are stored (default ~/.nettoolkit/data.db)
# NETTOOL_DB=
